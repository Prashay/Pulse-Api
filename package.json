{
  "name": "pulse-api-studio",
  "productName": "Pulse API Studio",
  "description": "Cross-platform API Client & Microservices Test Runner",
  "author": "Pulse API Studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"node server.js\" \"vite --host 0.0.0.0 --port 5173\"",
    "server": "node server.js",
    "client": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "desktop:build": "tsc -b && vite build && electron-builder",
    "desktop:build:win": "tsc -b && vite build && electron-builder --win",
    "desktop:build:mac": "tsc -b && vite build && electron-builder --mac",
    "desktop:build:mac:arm64": "tsc -b && vite build && electron-builder --mac --arm64",
    "desktop:build:mac:x64": "tsc -b && vite build && electron-builder --mac --x64",
    "desktop:build:mac:universal": "tsc -b && vite build && electron-builder --mac --universal",
    "desktop:build:all": "tsc -b && vite build && electron-builder -mw",
    "desktop:start": "electron ."
  },
  "build": {
    "appId": "com.pulseapistudio.app",
    "productName": "Pulse API Studio",
    "directories": {
      "output": "dist_electron"
    },
    "icon": "public/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "pulse-api-studio",
      "artifactName": "Pulse-API-Studio-Setup.${ext}",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pulse API Studio"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal",
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal",
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "Pulse-API-Studio-Universal.${ext}",
      "icon": "public/icon.png",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "public/icon.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "target": "dir",
      "icon": "public/icon.png"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "main.js",
      "preload.cjs",
      "server.js",
      "package.json"
    ]
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}