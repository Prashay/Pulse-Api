# ==============================================================================
# Pulse API Studio - Sample Environment Configuration (.env.example)
# Copy this file to .env or .env.local to customize your local development settings
# ==============================================================================

# Backend API Proxy Server Port (Default: 3001)
PORT=3001

# Frontend Vite Dev Server Port (Default: 5173)
VITE_PORT=5173

# Local API Engine Host URL
VITE_API_BASE_URL=http://127.0.0.1:3001

# Node Environment
NODE_ENV=development

# Request timeout limit in milliseconds
VITE_REQUEST_TIMEOUT=15000

# Sample Demo API Key for testing Authorization headers
SAMPLE_API_KEY=pulse_dev_token_8892
